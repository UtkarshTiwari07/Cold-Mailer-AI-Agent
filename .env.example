# ---------------------------------------------------------------------------
# Copy to .env and fill in. Nothing here is committed.
# The pipeline runs end-to-end with NO credentials at all in console transport
# with LLM stubbing enabled — see `make demo`.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Live model IDs as of 2026-07-24. The old `deepseek-chat` / `deepseek-reasoner`
# aliases were RETIRED on 2026-07-24 15:59 UTC and now return HTTP 400.
CM_LLM__FLASH_MODEL=deepseek/deepseek-v4-flash
CM_LLM__PRO_MODEL=deepseek/deepseek-v4-pro
CM_LLM__API_BASE=https://api.deepseek.com

# Hard ceiling. The run aborts rather than exceed this.
CM_LLM__MAX_SPEND_USD=25.0

# Set true to run the whole pipeline with deterministic canned LLM responses.
# No API key needed. Used by `make demo` and the test suite.
CM_LLM__STUB=false

# --- Storage ---------------------------------------------------------------
CM_DB__DSN=postgresql://coldmailer:coldmailer@localhost:5432/coldmailer
CM_REDIS__URL=redis://localhost:6379/0

# --- Search ----------------------------------------------------------------
CM_SEARCH__SEARXNG_URL=http://localhost:8888
# Optional paid fallback. Never required.
SERPER_API_KEY=

# --- Sending ---------------------------------------------------------------
# console = print to stdout (default, safe). gmail = real send. smtp = generic.
CM_DELIVERY__TRANSPORT=console
CM_DELIVERY__FROM_EMAIL=
CM_DELIVERY__FROM_NAME=
# OAuth client downloaded from Google Cloud Console (Desktop app type)
CM_DELIVERY__GMAIL_CLIENT_SECRETS=secrets/credentials.json
CM_DELIVERY__GMAIL_TOKEN_PATH=secrets/gmail_token.json

# --- Observability (all optional) ------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
